# ─── Required ───────────────────────────────────────────────────────────────────

# OpenRouter API key — used by the `verify_claim` faithfulness judge.
# Without this, the `verify_claim` MCP tool is disabled (server still starts).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Google Drive folder ID to index.
# Copy from the URL: https://drive.google.com/drive/folders/<FOLDER_ID>
ANCHOR_DRIVE_FOLDER_ID=1ABC...

# ─── Optional ───────────────────────────────────────────────────────────────────

# Vector backend (default: chroma — local, no account required).
# Set to "pinecone" to use Pinecone; requires PINECONE_API_KEY below.
ANCHOR_VECTOR_BACKEND=chroma

# Pinecone — only required when ANCHOR_VECTOR_BACKEND=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=anchor
