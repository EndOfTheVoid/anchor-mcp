# Local dev environment for `anchor` (loaded automatically by the CLI via python-dotenv).
# Copy to `.env` and fill in. For Cloud Run, these live in Secret Manager / env vars
# instead — see the deployment runbook.

# ─── Required ─────────────────────────────────────────────────────────────────

# Pinecone API key — vector storage + server-side embeddings (inference API).
# Get one at https://app.pinecone.io → API Keys.
PINECONE_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────

# OpenRouter API key — enables the `verify_claim` faithfulness-judge tool.
# Without it the server still starts; the tool is simply not registered.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Config-from-env (stateless mode). If `~/.anchor/config.json` is absent, the server
# builds its config from these instead. `anchor init` writes the file for local use,
# so locally you usually do NOT need these — they exist for Cloud Run.
ANCHOR_DRIVE_FOLDER_ID=
# ANCHOR_PINECONE_INDEX=anchor
# ANCHOR_SEARCH_ALPHA=0.7
# ANCHOR_JUDGE_MODEL=anthropic/claude-haiku-4-5
